msgid "unexpected option string: %s"
msgstr "예상하지 못한 옵션: %s"

#, python-format
msgid "unknown parser %(parser_name)r (choices: %(choices)s)"
msgstr "알 수 없는 명령 %(parser_name)r (선택: %(choices)s)"

#, python-format
msgid "unrecognized arguments: %s"
msgstr "알 수 없는 인수: %s"

msgid "usage: "
msgstr "사용법: "

msgid "y"
msgstr "ㅛ"

msgid "yes"
msgstr "예"

#, python-brace-format
msgid "{n} file"
msgid_plural "{n} files"
msgstr[0] "파일 {n}개"

#, python-brace-format
msgid "{tonic} major"
msgstr "{tonic} 장조"

#, python-brace-format
msgid "{tonic} minor"
msgstr "{tonic} 단조"

#, python-brace-format
msgid "♩ = {bpm} · {key}"
msgstr "♩ = {bpm} · {key}"


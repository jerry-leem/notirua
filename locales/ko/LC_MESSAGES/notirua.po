#, python-format
msgid " (default: %(default)s)"
msgstr " (기본값: %(default)s)"

#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s:"

#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: 오류: %(message)s\n"

#, python-brace-format
msgid "A required component is not installed: {name}."
msgstr "필요한 구성요소가 설치되지 않았습니다: {name}."

msgid "Agree to the component licenses without asking."
msgstr "묻지 않고 구성요소 라이선스에 동의합니다."

msgid "Agree to the licenses and install? [y/N] "
msgstr "라이선스에 동의하고 설치할까요? [y/N] "

msgid "All components are installed."
msgstr "모든 구성요소가 설치되어 있습니다."

msgid "Also save MIDI."
msgstr "MIDI 파일도 저장합니다."

msgid "Also save MusicXML."
msgstr "MusicXML 파일도 저장합니다."

msgid "Arranging staves and tablature"
msgstr "오선보와 TAB 악보를 배치하는 중"

msgid "Audio or video file to read."
msgstr "읽을 음악 또는 동영상 파일."

msgid "Audio track number when the file has several."
msgstr "오디오 트랙이 여러 개일 때 사용할 트랙 번호."

msgid "Bass"
msgstr "베이스"

msgid "Beats per minute, if detection is wrong."
msgstr "빠르기(BPM). 자동으로 찾은 값이 틀렸을 때 지정합니다."

msgid "Cancelled."
msgstr "취소했습니다."

msgid "Cannot write to the install location."
msgstr "설치 위치에 쓸 수 없습니다."

msgid "Check that the file plays in another app, or convert it to WAV or MP3."
msgstr "다른 앱에서 재생되는지 확인하거나 WAV 또는 MP3로 변환해 보세요."

msgid "Check your internet connection and try again."
msgstr "인터넷 연결을 확인한 뒤 다시 시도하세요."

msgid "Choose a file that contains sound."
msgstr "소리가 들어 있는 파일을 선택하세요."

msgid "Choose a folder you can write to."
msgstr "쓰기 권한이 있는 폴더를 선택하세요."

#, python-brace-format
msgid "Choose a section of {limit} minutes or less."
msgstr "{limit}분 이하의 구간을 선택하세요."

msgid "Choose which audio track to use."
msgstr "사용할 오디오 트랙을 선택하세요."

#, python-brace-format
msgid "Components installed in {seconds} s."
msgstr "구성요소를 {seconds}초 만에 설치했습니다."

msgid "Delete all saved intermediate results."
msgstr "저장된 중간 결과를 모두 지웁니다."

#, python-brace-format
msgid "Disk space needed: {size}"
msgstr "필요한 디스크 공간: {size}"

msgid "Do not make one PDF per instrument."
msgstr "악기별 PDF를 만들지 않습니다."

msgid "Do not make the all-instruments PDF."
msgstr "전체 악기 합본 PDF를 만들지 않습니다."

#, python-brace-format
msgid "Done in {seconds} s: {count}."
msgstr "{seconds}초 만에 완료: {count}."

msgid "Downloading components needs your permission first."
msgstr "구성요소를 내려받으려면 먼저 동의가 필요합니다."

#, python-brace-format
msgid "Downloading {name}"
msgstr "{name} 내려받는 중"

#, python-brace-format
msgid "Downloading {name}: {received} of {total}"
msgstr "{name} 내려받는 중: {received} / {total}"

msgid "Drawing the score took too long and was stopped."
msgstr "악보를 그리는 데 너무 오래 걸려 중단했습니다."

msgid "Drawing the sheet music"
msgstr "악보를 그리는 중"

#, python-brace-format
msgid "Drawing {instrument} sheet music ({index}/{count})"
msgstr "{instrument} 악보를 그리는 중 ({index}/{count})"

msgid "Draws the finished sheet music and saves it as PDF."
msgstr "완성된 악보를 그려 PDF로 저장합니다."

msgid "Drum sheet music is for reference only."
msgstr "드럼 악보는 참고용입니다."

msgid "Drums"
msgstr "드럼"

msgid "End time in seconds."
msgstr "끝 시각(초)."

#, python-brace-format
msgid "Error code: {code}"
msgstr "오류 코드: {code}"

#, python-brace-format
msgid "Error: {message}"
msgstr "오류: {message}"

#, python-brace-format
msgid "File not found: {path}"
msgstr "파일을 찾을 수 없습니다: {path}"

msgid "Finding the beat, tempo, and key"
msgstr "박자, 빠르기, 조성을 찾는 중"

msgid "Fitting notes to the beat"
msgstr "박자에 맞춰 정리하는 중"

msgid "Folder for the results."
msgstr "결과를 저장할 폴더."

msgid "For example 4/4 or 3/4."
msgstr "예: 4/4, 3/4."

#, python-brace-format
msgid "Free space: {size}"
msgstr "남은 공간: {size}"

msgid "Free up disk space or choose another install location."
msgstr "디스크 공간을 확보하거나 다른 설치 위치를 선택하세요."

#, python-brace-format
msgid "Freed {size}."
msgstr "{size}를 비웠습니다."

msgid "Guitar"
msgstr "기타"

msgid "Install from a component bundle file (no internet)."
msgstr "구성요소 묶음 파일로 설치합니다(인터넷 불필요)."

msgid "Install location."
msgstr "설치 위치."

#, python-brace-format
msgid "Install location: {path}"
msgstr "설치 위치: {path}"

msgid "Install the components Notirua needs."
msgstr "Notirua에 필요한 구성요소를 설치합니다."

msgid "Installed from the bundle file."
msgstr "묶음 파일로 설치했습니다."

#, python-brace-format
msgid "Installing {name}"
msgstr "{name} 설치하는 중"

msgid "Instrument separation model"
msgstr "악기 분리 모델"

#, python-brace-format
msgid "Instruments to include, comma separated: {choices}."
msgstr "포함할 악기(쉼표로 구분): {choices}."

msgid "Interface language, for example en or ko."
msgstr "화면 언어. 예: en, ko."

msgid "Key, if detection is wrong, for example \"D minor\"."
msgstr "조성. 자동으로 찾은 값이 틀렸을 때 지정합니다. 예: \"D minor\"."

msgid "Language for labels inside the PDF."
msgstr "PDF 안 라벨의 언어."

#, python-brace-format
msgid "License: {license} ({url})"
msgstr "라이선스: {license} ({url})"

msgid "List available languages."
msgstr "사용할 수 있는 언어를 보여 줍니다."

msgid "Listening for notes"
msgstr "음을 듣고 받아 적는 중"

#, python-brace-format
msgid "Listening for {instrument} notes ({index}/{count})"
msgstr "{instrument} 음을 받아 적는 중 ({index}/{count})"

msgid "Make sheet music from an audio file."
msgstr "음악 파일로 악보를 만듭니다."

msgid "Move the first beat by N beats."
msgstr "첫 박을 N박 밉니다."

msgid "Moved down one octave to fit the instrument."
msgstr "악기 음역에 맞추려고 한 옥타브 내렸습니다."

msgid "Moved up one octave to fit the instrument."
msgstr "악기 음역에 맞추려고 한 옥타브 올렸습니다."

msgid "No sound"
msgstr "소리 없음"

#, python-brace-format
msgid "Not enough disk space: {needed} needed, {available} available."
msgstr "디스크 공간이 부족합니다: {needed} 필요, {available} 남음."

msgid "Not selected"
msgstr "선택하지 않음"

#, python-brace-format
msgid "Note: {message}"
msgstr "참고: {message}"

msgid "Nothing was downloaded. Run “notirua setup” again any time."
msgstr "아무것도 내려받지 않았습니다. 언제든 “notirua setup”을 다시 실행하세요."

msgid "Notirua needs to download these components:"
msgstr "Notirua가 다음 구성요소를 내려받아야 합니다:"

msgid "Open setup and install the required components."
msgstr "설정을 열고 필요한 구성요소를 설치하세요."

msgid "Open the log folder for details and report the problem."
msgstr "로그 폴더에서 자세한 내용을 확인하고 문제를 알려 주세요."

msgid "Other"
msgstr "기타 소리"

msgid "Paper size."
msgstr "용지 크기."

msgid "Piano"
msgstr "피아노"

msgid "Reading the audio file"
msgstr "음악 파일을 읽는 중"

msgid "Remove an installed component."
msgstr "설치된 구성요소를 삭제합니다."

#, python-brace-format
msgid "Removed {name}."
msgstr "{name}을(를) 삭제했습니다."

msgid "Reusing earlier results"
msgstr "이전 결과를 다시 사용하는 중"

msgid "Review the components and choose “Agree and install”."
msgstr "구성요소를 확인하고 “동의하고 설치”를 누르세요."

msgid "Run again with --accept-licenses to agree without a prompt."
msgstr "묻지 않고 동의하려면 --accept-licenses를 붙여 다시 실행하세요."

msgid "Run “notirua setup” first."
msgstr "먼저 “notirua setup”을 실행하세요."

#, python-brace-format
msgid "Saved intermediate results: {size} in {path}"
msgstr "저장된 중간 결과: {size} ({path})"

msgid "Saving files"
msgstr "파일을 저장하는 중"

msgid "Score engraver (LilyPond)"
msgstr "악보 조판기 (LilyPond)"

msgid "Semitones to move, -12 to +12."
msgstr "옮길 반음 수, -12 ~ +12."

msgid "Show detailed log output."
msgstr "자세한 로그를 표시합니다."

msgid "Show installed components."
msgstr "설치된 구성요소를 보여 줍니다."

msgid "Show notation, tablature, or both."
msgstr "오선보, TAB 악보, 또는 둘 다 표시합니다."

msgid "Show or clear saved intermediate results."
msgstr "저장된 중간 결과를 보거나 지웁니다."

#, python-brace-format
msgid "Size: {size}"
msgstr "크기: {size}"

#, python-brace-format
msgid "Skipped {instrument}: {reason}"
msgstr "{instrument} 건너뜀: {reason}"

#, python-brace-format
msgid "Some components are not installed yet: {names}"
msgstr "아직 설치되지 않은 구성요소가 있습니다: {names}"

msgid "Some notes that cannot be played together were left out."
msgstr "함께 연주할 수 없는 음 일부를 뺐습니다."

msgid "Something went wrong."
msgstr "문제가 생겼습니다."

msgid "Song title printed on every page."
msgstr "모든 페이지에 들어갈 곡명."

#, python-brace-format
msgid "Source: {domain}"
msgstr "출처: {domain}"

msgid "Splits a song into vocals, drums, bass, guitar, piano, and other sounds."
msgstr "곡을 보컬, 드럼, 베이스, 기타, 피아노, 기타 소리로 나눕니다."

msgid "Splitting the song into instruments"
msgstr "악기별로 나누는 중"

msgid "Start it again whenever you are ready."
msgstr "준비되면 언제든 다시 시작하세요."

msgid "Start time in seconds."
msgstr "시작 시각(초)."

#, python-brace-format
msgid "The audio is longer than {limit} minutes."
msgstr "음악 길이가 {limit}분을 넘습니다."

msgid "The download failed."
msgstr "내려받기에 실패했습니다."

msgid "The downloaded file is damaged (checksum mismatch)."
msgstr "내려받은 파일이 손상되었습니다(체크섬 불일치)."

msgid "The file appears to be damaged."
msgstr "파일이 손상된 것 같습니다."

msgid "The file could not be read as audio."
msgstr "파일을 음악으로 읽을 수 없습니다."

msgid "The file has no audio track."
msgstr "파일에 오디오 트랙이 없습니다."

#, python-brace-format
msgid "The file has {count} audio tracks."
msgstr "파일에 오디오 트랙이 {count}개 있습니다."

msgid "The file is copy-protected (DRM) and cannot be opened."
msgstr "복제 방지(DRM)가 걸린 파일이라 열 수 없습니다."

msgid ""
"The internet is used only for this download. Notirua works offline "
"afterwards."
msgstr "인터넷 연결은 이 다운로드에만 사용되며, 이후에는 오프라인으로 동작합니다."

msgid "The score could not be drawn."
msgstr "악보를 그리지 못했습니다."

msgid "The task was cancelled."
msgstr "작업을 취소했습니다."

msgid "There is not enough disk space."
msgstr "디스크 공간이 부족합니다."

#, python-brace-format
msgid "Total download: {size}"
msgstr "전체 다운로드 크기: {size}"

msgid "Transpose must be between -12 and +12."
msgstr "전조 값은 -12에서 +12 사이여야 합니다."

msgid "Transpose to this key, for example \"G major\"."
msgstr "이 조로 전조합니다. 예: \"G major\"."

msgid "Try a different copy of the file."
msgstr "다른 사본 파일로 시도해 보세요."

msgid "Try again. If the problem continues, open the log folder and report it."
msgstr "다시 시도하세요. 문제가 계속되면 로그 폴더를 열어 알려 주세요."

msgid "Try again. The damaged file has been removed."
msgstr "다시 시도하세요. 손상된 파일은 지웠습니다."

msgid "Try fewer instruments or a shorter section."
msgstr "악기 수를 줄이거나 더 짧은 구간으로 시도하세요."

msgid "Turn a song into sheet music and tablature PDFs."
msgstr "음악을 악보와 TAB 악보 PDF로 만듭니다."

#, python-brace-format
msgid "Unknown instrument: {name}"
msgstr "알 수 없는 악기: {name}"

msgid "Use a file without copy protection."
msgstr "복제 방지가 없는 파일을 사용하세요."

msgid "Vocals"
msgstr "보컬"

#, python-brace-format
msgid "What to do: {hint}"
msgstr "해결 방법: {hint}"

#, python-brace-format
msgid "about {time} left"
msgstr "약 {time} 남음"

#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "옵션 %(option)s이(가) 여러 옵션과 일치합니다: %(matches)s"

#, python-format
msgid "argument \"-\" with mode %r"
msgstr "\"-\" 인수는 %r 모드로 열 수 없습니다"

#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "인수 %(argument_name)s: %(message)s"

#, python-format
msgid "can't open '%(filename)s': %(error)s"
msgstr "'%(filename)s' 파일을 열 수 없습니다: %(error)s"

msgid "command"
msgstr "명령"


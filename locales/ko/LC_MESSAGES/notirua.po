msgid "one of the arguments %s is required"
msgstr "다음 인수 중 하나가 필요합니다: %s"

msgid "options"
msgstr "옵션"

msgid "positional arguments"
msgstr "위치 인수"

msgid "show program's version number and exit"
msgstr "프로그램 버전을 보여 주고 끝냅니다"

msgid "show this help message and exit"
msgstr "이 도움말을 보여 주고 끝냅니다"

msgid "standard, drop_d, half_down, or MIDI numbers."
msgstr "standard, drop_d, half_down 또는 MIDI 번호."

msgid "standard, five_string, drop_d, half_down, or MIDI numbers."
msgstr "standard, five_string, drop_d, half_down 또는 MIDI 번호."

#, python-format
msgid "the following arguments are required: %s"
msgstr "다음 인수가 필요합니다: %s"

